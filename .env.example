# ─────────────────────────────────────────────────────────────────────
# BrandWave — frontend (Next.js) environment
# Copy to `.env` and fill in. NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────────────

# Supabase — project URL and keys (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI backend base URL.
#   local  -> http://localhost:8000
#   AWS EC2 -> http://<your-elastic-ip>:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
