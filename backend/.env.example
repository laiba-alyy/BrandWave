# ─────────────────────────────────────────────────────────────────────
# BrandWave — backend (FastAPI) environment
# Copy to `backend/.env` and fill in. NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=change-me-to-a-long-random-string

# ── Supabase (server-side) ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── URLs / CORS ──────────────────────────────────────────────────────
# In production point these at your domain or Elastic IP.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public URL of THIS backend — used to build the embeddable chatbot <script> tag.
BACKEND_PUBLIC_URL=http://localhost:8000

# ── LLMs ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_SEO_KEYWORDS=openai/gpt-oss-120b
GROKAPIKEY2=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Image ad generation ──────────────────────────────────────────────
HF_API_KEY=
POLLINATIONS_KEY=
CLAID_API_KEY=
BRIA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Video ads (fal.ai — powers BOTH Kling free tier and Veo premium) ──
FAL_API_KEY=
# Optional overrides; defaults live in the code.
#   modules/video_ads/kling_service.py::MODEL_REGISTRY
#   modules/video_ads/veo_service.py::MODEL_REGISTRY
# FAL_KLING_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# FAL_VEO_MODEL=fal-ai/veo3.1/lite/image-to-video
# FAL_VEO_RESOLUTION=720p
# FAL_POLL_TIMEOUT=900
OPENAI_TTS_KEY=

# ── SEO ──────────────────────────────────────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Sentiment / scraping ─────────────────────────────────────────────
YOUTUBE_API_KEY=
PINECONE_API_KEY=

# ── Chatbot escalation email alerts ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail: use an App Password, not your account password.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
